# ==============================================================================
# FIFFY'S MATCH MAKING - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER (BACKEND) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# SUPABASE CLOUD DATABASE (REQUIRED for persistence across Render restarts)
# 1. Go to your Supabase Project -> Project Settings -> API
# 2. Copy the "Project URL" and "service_role" (secret) key
# 3. Add these to your Render Web Service Environment Variables:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# (Optional fallback if service_role key is not used):
SUPABASE_ANON_KEY=your-supabase-anon-key

# DO WE NEED FCM (Firebase Cloud Messaging) VARIABLES ON RENDER?
# -> NO. You DO NOT need FCM variables or Firebase service account keys on Render.
# The backend includes a native FCM device registration registry and push pipeline
# (/api/fcm/register-token, /api/fcm/tokens, /api/fcm/send-test) that works without
# requiring any external Firebase credentials or credentials files.

# PORT: Render sets this automatically. Leave blank or 3000.
PORT=3000

# NODE_ENV: Set to "production" on Render
NODE_ENV=production

# GEMINI_API_KEY: Optional server-side Gemini AI API key for chemistry audits
GEMINI_API_KEY=

# APP_URL: The public URL of your backend on Render
APP_URL=https://fiffy.onrender.com

# Optional PayFast Gateway Overrides (Can also be configured in the Admin Portal UI)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# ------------------------------------------------------------------------------
# 2. VERCEL (FRONTEND) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Set this in your Vercel Project Settings -> Environment Variables.
# This points all web frontend API calls to your live Render backend.
VITE_API_BASE_URL=https://fiffy.onrender.com

# ------------------------------------------------------------------------------
# 3. EXPO / REACT NATIVE (MOBILE APP) ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL: Defaults to https://fiffy.onrender.com in mobile/src/context/AppContext.tsx.
# You only need to set this if you want to override the production backend during local testing.
EXPO_PUBLIC_API_URL=https://fiffy.onrender.com
