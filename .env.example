# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- VERCEL (FRONTEND) CONFIGURATION ---
# Set this in your Vercel project environment variables to point to your Render backend API
# Example: https://fiffys-api.onrender.com
VITE_API_BASE_URL=""

# Client-side Supabase keys (if connecting directly from React/Expo)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- RENDER (BACKEND) CONFIGURATION ---
# Render assigns PORT automatically (e.g. 10000 or 3000)
PORT="3000"

# Server-side Supabase credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

